+import QtQuick
+import qs.Common
+import qs.DCommon.Widgets
+import qs.Services
+
+DActionButton {
+    readonly property var speedTest: PluginService.pluginDaemonInstances["networkSpeed"]
+
+    anchors.verticalCenter: parent.verticalCenter
+    visible: NetworkService.wifiConnected && !NetworkService.wifiToggling && !!speedTest
+    buttonSize: Theme.buttonHeightXS
+    iconSize: Theme.iconSizeMedium
+    iconName: "speed"
+    tooltipText: "Internet speed test"
+    iconColor: Theme.surfaceText
+    onClicked: speedTest?.openWindow()
+}
